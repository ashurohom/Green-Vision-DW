<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_instance_form" model="ir.ui.view">
        <field name="name">shopify.instance.form</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <form string="Shopify Instance">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                    <button name="action_sync_all" string="Sync All" type="object"/>
                    <button name="action_sync_customers" string="Sync Customers" type="object"/>
                    <button name="action_sync_orders" string="Sync Orders" type="object"/>
                    <button name="action_sync_payments" string="Sync Payments" type="object"/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="not_tested,success,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. My Shopify Store"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="store_url" placeholder="https://your-store.myshopify.com"/>
                            <field name="api_version"/>
                            <field name="access_token" password="True"/>
                        </group>
                        <group>
                            <field name="auto_sync"/>
                            <field name="last_sync_datetime"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_instance_tree" model="ir.ui.view">
        <field name="name">shopify.instance.tree</field>
        <field name="model">shopify.instance</field>
        <field name="arch" type="xml">
            <list string="Shopify Instances">
                <field name="name"/>
                <field name="store_url"/>
                <field name="connection_status" widget="badge" decoration-success="connection_status == 'success'" decoration-danger="connection_status == 'failed'"/>
                <field name="auto_sync"/>
                <field name="last_sync_datetime"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_instance" model="ir.actions.act_window">
        <field name="name">Shopify Instances</field>
        <field name="res_model">shopify.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_instance" 
              name="Shopify Instances" 
              parent="menu_shopify_config" 
              action="action_shopify_instance" 
              sequence="10"/>
</odoo>
