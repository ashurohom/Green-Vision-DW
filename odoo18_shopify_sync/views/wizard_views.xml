<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_manual_sync_form" model="ir.ui.view">
        <field name="name">shopify.manual.sync.form</field>
        <field name="model">shopify.manual.sync</field>
        <field name="arch" type="xml">
            <form string="Manual Sync">
                <sheet>
                    <group>
                        <field name="instance_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_import_all" string="Import All" type="object" class="btn-primary"/>
                        <button name="action_import_customers" string="Import Customers" type="object" class="btn-secondary"/>
                        <button name="action_import_orders" string="Import Orders" type="object" class="btn-secondary"/>
                        <button name="action_import_payments" string="Import Payments" type="object" class="btn-secondary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_manual_sync" model="ir.actions.act_window">
        <field name="name">Manual Sync</field>
        <field name="res_model">shopify.manual.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_shopify_manual_sync" 
              name="Sync Wizard" 
              parent="menu_shopify_operations" 
              action="action_shopify_manual_sync" 
              sequence="10"/>
</odoo>
