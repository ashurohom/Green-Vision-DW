<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_payment_tree" model="ir.ui.view">
        <field name="name">shopify.payment.tree</field>
        <field name="model">shopify.payment</field>
        <field name="arch" type="xml">
            <list string="Shopify Payments" create="false" edit="false">
                <field name="transaction_id"/>
                <field name="sale_order_id"/>
                <field name="payment_date"/>
                <field name="payment_gateway"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_payment_form" model="ir.ui.view">
        <field name="name">shopify.payment.form</field>
        <field name="model">shopify.payment</field>
        <field name="arch" type="xml">
            <form string="Shopify Payment" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="transaction_id"/>
                            <field name="sale_order_id"/>
                            <field name="payment_gateway"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="payment_date"/>
                            <field name="payment_status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_payment" model="ir.actions.act_window">
        <field name="name">Shopify Payments</field>
        <field name="res_model">shopify.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_payment" 
              name="Payments" 
              parent="menu_shopify_operations" 
              action="action_shopify_payment" 
              sequence="20"/>
</odoo>
