<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Final Evaluation Tree View -->
    <record id="view_epm_final_evaluation_tree" model="ir.ui.view">
        <field name="name">epm.final.evaluation.tree</field>
        <field name="model">epm.final.evaluation</field>
        <field name="arch" type="xml">
            <list string="Final Evaluations">
                <field name="name"/>
                <field name="assignment_id"/>
                <field name="employee_id"/>
                <field name="overall_score" widget="progressbar"/>
                <field name="performance_rating_id"/>
            </list>
        </field>
    </record>

    <!-- Final Evaluation Form View -->
    <record id="view_epm_final_evaluation_form" model="ir.ui.view">
        <field name="name">epm.final.evaluation.form</field>
        <field name="model">epm.final.evaluation</field>
        <field name="arch" type="xml">
            <form string="Final Evaluation">
                <header>
                    <button name="action_calculate" string="Calculate Score" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assignment_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="overall_score" widget="progressbar"/>
                            <field name="performance_rating_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluation Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="type"/>
                                    <field name="name"/>
                                    <field name="score"/>
                                </list>
                            </field>
                        </page>
                        <page string="Final Comment">
                            <field name="final_comment" placeholder="Provide final comments or summary..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Final Evaluation Search View -->
    <record id="view_epm_final_evaluation_search" model="ir.ui.view">
        <field name="name">epm.final.evaluation.search</field>
        <field name="model">epm.final.evaluation</field>
        <field name="arch" type="xml">
            <search string="Search Final Evaluations">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignment_id"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Performance Rating" name="group_by_rating" context="{'group_by': 'performance_rating_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Final Evaluation Action -->
    <record id="action_epm_final_evaluation" model="ir.actions.act_window">
        <field name="name">Final Evaluations</field>
        <field name="res_model">epm.final.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_epm_final_evaluation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Final Evaluation!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epm_final_evaluation" name="Final Evaluations" parent="menu_epm_performance" action="action_epm_final_evaluation" sequence="40"/>

</odoo>
