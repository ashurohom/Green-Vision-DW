<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self Review Tree View -->
    <record id="view_epm_self_review_tree" model="ir.ui.view">
        <field name="name">epm.self.review.tree</field>
        <field name="model">epm.self.review</field>
        <field name="arch" type="xml">
            <list string="Self Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignment_id"/>
                <field name="review_cycle_id"/>
            </list>
        </field>
    </record>

    <!-- Self Review Form View -->
    <record id="view_epm_self_review_form" model="ir.ui.view">
        <field name="name">epm.self.review.form</field>
        <field name="model">epm.self.review</field>
        <field name="arch" type="xml">
            <form string="Self Review">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assignment_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="review_cycle_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Self Review Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="kra_id"/>
                                    <field name="kpa_id"/>
                                    <field name="kpi_id"/>
                                    <field name="target_value"/>
                                    <field name="completed_value"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <field name="automatic_score"/>
                                    <field name="achievement"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Self Review Search View -->
    <record id="view_epm_self_review_search" model="ir.ui.view">
        <field name="name">epm.self.review.search</field>
        <field name="model">epm.self.review</field>
        <field name="arch" type="xml">
            <search string="Search Self Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="assignment_id"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Review Cycle" name="group_by_cycle" context="{'group_by': 'review_cycle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Self Review Action -->
    <record id="action_epm_self_review" model="ir.actions.act_window">
        <field name="name">Self Reviews</field>
        <field name="res_model">epm.self.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_epm_self_review_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Self Review!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epm_self_review" name="Self Reviews" parent="menu_epm_performance" action="action_epm_self_review" sequence="20"/>

</odoo>
