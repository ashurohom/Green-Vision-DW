<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Assignment Tree View -->
    <record id="view_epm_employee_assignment_tree" model="ir.ui.view">
        <field name="name">epm.employee.assignment.tree</field>
        <field name="model">epm.employee.assignment</field>
        <field name="arch" type="xml">
            <list string="Employee Assignments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="review_cycle_id"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'running'" decoration-success="status == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Employee Assignment Form View -->
    <record id="view_epm_employee_assignment_form" model="ir.ui.view">
        <field name="name">epm.employee.assignment.form</field>
        <field name="model">epm.employee.assignment</field>
        <field name="arch" type="xml">
            <form string="Employee Assignment">
                <header>
                    <button name="action_run" string="Start Assignment" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="status != 'running'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="review_cycle_id"/>
                            <field name="performance_template_id"/>
                            <field name="assignment_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee Assignment Search View -->
    <record id="view_epm_employee_assignment_search" model="ir.ui.view">
        <field name="name">epm.employee.assignment.search</field>
        <field name="model">epm.employee.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Assignments">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <filter string="Running" name="running" domain="[('status', '=', 'running')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Manager" name="group_by_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Employee Assignment Action -->
    <record id="action_epm_employee_assignment" model="ir.actions.act_window">
        <field name="name">Employee Assignments</field>
        <field name="res_model">epm.employee.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_epm_employee_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign a Performance Template to an Employee!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epm_employee_assignment" name="Employee Assignments" parent="menu_epm_performance" action="action_epm_employee_assignment" sequence="10"/>

</odoo>
