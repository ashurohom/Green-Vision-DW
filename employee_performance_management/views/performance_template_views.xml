<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Performance Template Tree View -->
    <record id="view_epm_performance_template_tree" model="ir.ui.view">
        <field name="name">epm.performance.template.tree</field>
        <field name="model">epm.performance.template</field>
        <field name="arch" type="xml">
            <list string="Performance Templates">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Performance Template Form View -->
    <record id="view_epm_performance_template_form" model="ir.ui.view">
        <field name="name">epm.performance.template.form</field>
        <field name="model">epm.performance.template</field>
        <field name="arch" type="xml">
            <form string="Performance Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name (e.g., Software Developer)"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="description" placeholder="Description of the template..."/>
                    </group>
                    <notebook>
                        <page string="KRAs">
                            <field name="kra_ids" widget="many2many">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="weightage"/>
                                </list>
                            </field>
                        </page>
                        <page string="KPAs">
                            <field name="kpa_ids" widget="many2many">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kra_id"/>
                                    <field name="weightage"/>
                                </list>
                            </field>
                        </page>
                        <page string="KPIs">
                            <field name="kpi_ids" widget="many2many">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="kpa_id"/>
                                    <field name="weightage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Performance Template Search View -->
    <record id="view_epm_performance_template_search" model="ir.ui.view">
        <field name="name">epm.performance.template.search</field>
        <field name="model">epm.performance.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Performance Template Action -->
    <record id="action_epm_performance_template" model="ir.actions.act_window">
        <field name="name">Performance Templates</field>
        <field name="res_model">epm.performance.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_epm_performance_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Performance Template!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epm_performance_template" name="Performance Templates" parent="menu_epm_masters" action="action_epm_performance_template" sequence="60"/>

</odoo>
