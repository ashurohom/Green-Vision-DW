<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manager Review Tree View -->
    <record id="view_epm_manager_review_tree" model="ir.ui.view">
        <field name="name">epm.manager.review.tree</field>
        <field name="model">epm.manager.review</field>
        <field name="arch" type="xml">
            <list string="Manager Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="self_review_id"/>
                <field name="manager_rating"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Manager Review Form View -->
    <record id="view_epm_manager_review_form" model="ir.ui.view">
        <field name="name">epm.manager.review.form</field>
        <field name="model">epm.manager.review</field>
        <field name="arch" type="xml">
            <form string="Manager Review">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="status != 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="self_review_id"/>
                            <field name="assignment_id"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="manager_id"/>
                            <field name="manager_rating"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Remarks">
                            <group>
                                <field name="manager_remarks" placeholder="Provide manager remarks here..."/>
                                <field name="suggested_improvement" placeholder="Suggest areas for improvement..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Manager Review Search View -->
    <record id="view_epm_manager_review_search" model="ir.ui.view">
        <field name="name">epm.manager.review.search</field>
        <field name="model">epm.manager.review</field>
        <field name="arch" type="xml">
            <search string="Search Manager Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('status', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter string="Manager" name="group_by_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Manager Review Action -->
    <record id="action_epm_manager_review" model="ir.actions.act_window">
        <field name="name">Manager Reviews</field>
        <field name="res_model">epm.manager.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_epm_manager_review_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Manager Review!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epm_manager_review" name="Manager Reviews" parent="menu_epm_performance" action="action_epm_manager_review" sequence="30"/>

</odoo>
